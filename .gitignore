# Secrets: never commit. .env.example (names only) is committed.
.env
.env.*
!.env.example
!web/.env.mock

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node (web/dist is pre-built and IS committed)
node_modules/
*.tsbuildinfo

# Run output and logs
*.log
runs/
var/cache/
eval/runs/
eval/runs_*/
simusers/runs/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/

